@page "/search"
@inject MapDataService Data

<PageTitle>[enbmaps.de] Search</PageTitle>

<div id="ueberschrift">Searching for "@Query" ...</div>

<div class="suchfenster">
    @if (results is not null)
    {
        <p>... found <b>@results.Count</b> results</p>

        @if (results.Sectors.Count > 0)
        {
            <table class="search-group" cellspacing="0">
                <tr>
                    <td rowspan="@(results.Sectors.Count + 1)" class="grossesicon"><img src="bilder/overview-sektor.png" width="64" height="64" alt="" /></td>
                    <td colspan="3" class="header">Sectors</td>
                </tr>
                @for (int i = 0; i < results.Sectors.Count; i++)
                {
                    var sector = results.Sectors[i];
                    <tr>
                        <td class="nummer">#@(i + 1)</td>
                        <td class="kleinesicon"><img src="bilder/@Data.SectorIcon(sector.Id)" width="32" height="32" alt="" /></td>
                        <td class="result">
                            <a href="map/@sector.Id">@sector.Name</a>
                            <div class="ort">(@sector.SystemName System)</div>
                        </td>
                    </tr>
                }
            </table>
        }

        @if (results.Objects.Count > 0)
        {
            <table class="search-group" cellspacing="0">
                <tr>
                    <td rowspan="@(results.Objects.Count + 1)" class="grossesicon"><img src="bilder/overview-nav.png" width="64" height="64" alt="" /></td>
                    <td colspan="3" class="header">Navs</td>
                </tr>
                @for (int i = 0; i < results.Objects.Count; i++)
                {
                    var result = results.Objects[i];
                    <tr>
                        <td class="nummer">#@(i + 1)</td>
                        <td class="kleinesicon">
                            <img src="bilder/icon@(result.Object.TooltipIcon).gif" width="32" height="32" alt=""
                                 onerror="this.onerror=null;this.src='bilder/@result.Object.Icon'" />
                        </td>
                        <td class="result">
                            <a href="map/@result.Sector.Id?focus=@result.Index">@result.Object.Name</a>
                            <div class="ort">
                                <img src="bilder/@result.Object.Icon" width="12" height="12" alt="" /> @result.Object.Type
                                &nbsp;|&nbsp;
                                <img src="bilder/@Data.SectorIcon(result.Sector.Id)" width="12" height="12" alt="" /> @result.Sector.Name (@result.Sector.SystemName)
                            </div>
                        </td>
                    </tr>
                }
            </table>
        }
    }
</div>

@code {
    private SearchResults? results;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await Data.LoadAsync();
        results = Data.Search(Query);
    }
}
