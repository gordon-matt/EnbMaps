@page "/stations"
@inject MapDataService Data

<PageTitle>[enbmaps.de] Station List</PageTitle>

<div id="ueberschrift">Station List</div>

@if (stationList is not null)
{
    <div class="suchfenster stationlist">
        <table cellspacing="0">
            <tr>
                <td colspan="2"></td>
                @foreach (string icon in stationList.ColumnIcons)
                {
                    <td class="infoterminal"><img src="bilder/@icon" width="24" height="24" alt="@ColumnTitle(icon)" title="@ColumnTitle(icon)" /></td>
                }
            </tr>
            @for (int i = 0; i < stationList.Entries.Count; i++)
            {
                var entry = stationList.Entries[i];
                string shade = i % 2 == 0 ? "dunkel" : "hell";
                <tr>
                    <td rowspan="2" class="nummer @shade">#@entry.Number</td>
                    <td class="stationsname @shade"><a href="map/@entry.SectorId">@entry.Name</a></td>
                    @for (int c = 0; c < entry.Cells.Count && c < stationList.ColumnIcons.Count; c++)
                    {
                        <td rowspan="2" class="@CellClass(stationList.ColumnIcons[c]) @shade">@((MarkupString)entry.Cells[c])</td>
                    }
                </tr>
                <tr>
                    <td class="infozeile @shade">
                        <div class="infozeile-content">
                            <span class="infozeile-part">
                                <img src="bilder/@entry.SectorIcon" width="24" height="24" alt="" />
                                <span class="sektorname">@entry.SectorName</span>
                            </span>
                            <span class="infozeile-part">
                                @if (entry.FactionIcon is { } faction)
                                {
                                    <img src="bilder/@faction.Src" width="@faction.Width" height="@faction.Height" alt="" />
                                }
                                <span class="sektorname">@entry.FactionName</span>
                            </span>
                        </div>
                    </td>
                </tr>
            }
        </table>
    </div>
}

@code {
    private StationList? stationList;

    protected override async Task OnInitializedAsync() => stationList = (await Data.LoadAsync()).StationList;

    /// <summary>Column header icons are named station_term_{kind}.png or station_vendor_{kind}.png.</summary>
    private static string ColumnKind(string icon) => Path.GetFileNameWithoutExtension(icon).Split('_').Last();

    private static string ColumnTitle(string icon) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(ColumnKind(icon));

    private static string CellClass(string icon) =>
        icon.Contains("_vendor_", StringComparison.Ordinal) ? $"infovendor vendor-{ColumnKind(icon)}" : "infoterminal";
}
