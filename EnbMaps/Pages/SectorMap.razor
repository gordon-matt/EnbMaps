@page "/map/{SectorId}"
@implements IDisposable
@inject MapDataService Data
@inject MapSettings Settings
@inject NavigationManager Navigation

<PageTitle>[enbmaps.de] @(sector?.Title ?? SectorId)</PageTitle>

@if (loaded && sector is null)
{
    <div id="ueberschrift">Unknown sector "@SectorId"</div>
}
else if (sector is not null)
{
    <div id="ueberschrift">@sector.Title</div>

    <MapViewport @ref="viewport" Rect="fitRect" YUp="true" CssClass="sektorkarte" OnReady="OnViewportReady">
        <ChildContent>
            <div class="map-axis-x"></div>
            <div class="map-axis-y"></div>

            @if (sector.Bounds is { } bounds)
            {
                <div class="map-place map-bounds" style="@Rect(bounds.MinX, bounds.MaxY, bounds.MaxX - bounds.MinX, bounds.MaxY - bounds.MinY)"></div>
            }

            @foreach (var image in sector.Images.Where(x => Settings.IsVisible(MapLayers.For(x))))
            {
                <img class="map-place map-img @(image.Layer == MapImageLayer.GravityWell ? "gravwell" : "bild")"
                     src="bilder/@image.Src" alt="" draggable="false"
                     style="@Rect(image.X, image.Y, image.Width, image.Height)" />
            }

            @for (int i = 0; i < sector.Objects.Count; i++)
            {
                var mapObject = sector.Objects[i];
                if (!Settings.IsVisible(MapLayers.For(mapObject)))
                {
                    continue;
                }

                <div class="map-place map-nav @(mapObject == selected ? "selected" : null)" style="@Point(mapObject.X, mapObject.Y)" @key="mapObject.Id">
                    <img class="nav-icon" src="bilder/@mapObject.Icon" width="16" height="16" alt="@mapObject.Name" draggable="false"
                         @onmouseover="() => ShowTooltip(mapObject)" @onmouseout="HideTooltip" @onclick="() => Select(mapObject)" />

                    @if ((Settings.ShowNames || Settings.ShowCoordinates) && mapObject.Label is { } label)
                    {
                        <div class="nav-label @mapObject.Style @label.Align.ToString().ToLowerInvariant()"
                             style="left:@(label.Dx - 8)px; top:@(label.Dy - 8)px;"
                             @onmouseover="() => ShowTooltip(mapObject)" @onmouseout="HideTooltip" @onclick="() => Select(mapObject)">
                            @if (Settings.ShowNames)
                            {
                                @mapObject.Name
                            }
                            @if (Settings.ShowCoordinates)
                            {
                                if (Settings.ShowNames)
                                {
                                    <br />
                                }
                                @Coordinates(mapObject)
                            }
                        </div>
                    }
                </div>
            }

            <div class="mouseoverbox @(hovered is null ? null : "visible")">
                @if (hovered is not null)
                {
                    <NavInfo MapObject="hovered" />
                }
            </div>
        </ChildContent>
        <Controls>
            <div class="map-ui map-layers @(layersOpen ? "open" : null)">
                <button type="button" class="map-layers-toggle" @onclick="() => layersOpen = !layersOpen">Layers</button>
                @if (layersOpen)
                {
                    <ul>
                        @foreach (var (layer, name) in MapLayers.All)
                        {
                            <li>
                                <label>
                                    <input type="checkbox" checked="@Settings.IsVisible(layer)" @onchange="() => Settings.ToggleLayer(layer)" />
                                    @name
                                </label>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (selected is not null)
            {
                <div class="map-ui selection mouseoverbox visible">
                    <button type="button" class="close" title="Close" @onclick="() => selected = null">&times;</button>
                    <NavInfo MapObject="selected" />
                    <div class="selection-actions">
                        <button type="button" @onclick="() => FocusAsync(selected)">Center</button>
                        @if (selected.TargetSectorId is not null)
                        {
                            <a href="map/@selected.TargetSectorId">Go to @Data.SectorName(selected.TargetSectorId) &raquo;</a>
                        }
                    </div>
                </div>
            }

            @if (sector.Stations.Count > 0)
            {
                <div class="map-ui station-panels @(stationsOpen ? null : "collapsed")">
                    <button type="button" class="station-toggle" @onclick="() => stationsOpen = !stationsOpen">
                        @(stationsOpen ? "Hide stations" : $"Stations ({sector.Stations.Count})")
                    </button>
                    @if (stationsOpen)
                    {
                        @foreach (var station in sector.Stations)
                        {
                            <div class="station">@((MarkupString)station.Html)</div>
                        }
                    }
                </div>
            }
        </Controls>
    </MapViewport>
}

@code {
    private Sector? sector;
    private bool loaded;
    private WorldRect fitRect = new(0, 0, 1, 1);
    private MapViewport? viewport;
    private MapObject? hovered;
    private MapObject? selected;
    private bool layersOpen;
    private bool stationsOpen = true;
    private bool pendingFocus;
    private bool viewportReady;

    [Parameter]
    public string SectorId { get; set; } = string.Empty;

    /// <summary>Index of an object to centre on and highlight (used by search results).</summary>
    [SupplyParameterFromQuery(Name = "focus")]
    public int? Focus { get; set; }

    protected override void OnInitialized() => Settings.Changed += OnSettingsChanged;

    protected override async Task OnParametersSetAsync()
    {
        await Data.LoadAsync();
        var newSector = Data.FindSector(SectorId);
        if (newSector != sector)
        {
            sector = newSector;
            hovered = null;
            selected = null;
            viewportReady = false;
            fitRect = sector is null ? fitRect : ComputeFitRect(sector);
        }

        loaded = true;
        if (sector is not null && Focus is int index && index >= 0 && index < sector.Objects.Count)
        {
            selected = sector.Objects[index];
            pendingFocus = true;
        }
    }

    private async Task OnViewportReady()
    {
        viewportReady = true;
        await ApplyPendingFocusAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => viewportReady ? ApplyPendingFocusAsync() : Task.CompletedTask;

    private async Task ApplyPendingFocusAsync()
    {
        if (pendingFocus && selected is not null)
        {
            pendingFocus = false;
            await FocusAsync(selected);
        }
    }

    private async Task FocusAsync(MapObject mapObject)
    {
        if (viewport is not null)
        {
            await viewport.CenterOnAsync(mapObject.X, mapObject.Y, 3);
        }
    }

    private void Select(MapObject mapObject)
    {
        if (mapObject.TargetSectorId is not null && Data.FindSector(mapObject.TargetSectorId) is not null)
        {
            Navigation.NavigateTo($"map/{mapObject.TargetSectorId}");
            return;
        }

        selected = mapObject == selected ? null : mapObject;
    }

    private void ShowTooltip(MapObject mapObject) => hovered = mapObject;

    private void HideTooltip() => hovered = null;

    /// <summary>Default view: all navs, with some padding. Falls back to the sector bounds.</summary>
    private static WorldRect ComputeFitRect(Sector sector)
    {
        if (sector.Objects.Count == 0)
        {
            return sector.Bounds ?? new WorldRect(-100, -100, 100, 100);
        }

        double minX = sector.Objects.Min(x => x.X), maxX = sector.Objects.Max(x => x.X);
        double minY = sector.Objects.Min(x => x.Y), maxY = sector.Objects.Max(x => x.Y);
        double padX = Math.Max((maxX - minX) * 0.1, 10), padY = Math.Max((maxY - minY) * 0.1, 10);
        return new WorldRect(minX - padX, minY - padY, maxX + padX, maxY + padY);
    }

    private static string Point(double x, double y) =>
        string.Create(CultureInfo.InvariantCulture, $"--x:{x}; --y:{y};");

    private static string Rect(double x, double y, double width, double height) =>
        string.Create(CultureInfo.InvariantCulture, $"--x:{x}; --y:{y}; --w:{width}; --h:{height};");

    private static string Coordinates(MapObject mapObject) =>
        string.Create(CultureInfo.InvariantCulture, $"{mapObject.X:0.00}|{mapObject.Y:0.00}|{mapObject.Z:0.00}");

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Settings.Changed -= OnSettingsChanged;
}
